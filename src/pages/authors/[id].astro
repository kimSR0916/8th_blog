---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return (await getCollection('authors')).map((author) => ({
    params: { id: author.id },
    props: { author, posts: posts.filter((p) => p.data.authors.some((ref) => ref.id === author.id)) },
  }));
}

const { author, posts } = Astro.props;
const { name, role, bio, github } = author.data;
---

<Base title={name} description={bio ?? `${name}의 글`}>
  <h1 class="page-title">{name}</h1>
  <p class="page-sub">
    {[role, bio].filter(Boolean).join(' · ')}
    {github && <a href={`https://github.com/${github}`}>GitHub</a>}
  </p>
  <PostList posts={posts} />
</Base>
