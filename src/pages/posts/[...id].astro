---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { authorUrl, formatDate, getAuthors, getPosts, postUrl, readingMinutes, tagUrl } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags, draft } = post.data;
const { Content, headings } = await render(post);
const authors = await getAuthors(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title={title} description={description} type="article" published={date} noindex={draft}>
  <div class:list={['post', { 'has-toc': toc.length > 1 }]}>
    <article data-pagefind-body>
      <header class="post-header">
        <h1 data-pagefind-meta="title">{title}</h1>
        {draft && <p><span class="draft">초안</span></p>}
        <p class="lead">{description}</p>
        <p class="meta" data-pagefind-ignore>
          <span>{authors.map((a, i) => <Fragment>{i > 0 && ', '}<a href={authorUrl(a)}>{a.data.name}</a></Fragment>)}</span>
          <time datetime={iso(date)}>{formatDate(date)}</time>
          {updated && <span>수정 <time datetime={iso(updated)}>{formatDate(updated)}</time></span>}
          <span>{readingMinutes(post.body)}분 분량</span>
        </p>
      </header>
      <div class="prose"><Content /></div>
      {tags.length > 0 && (
        <ul class="tag-row" aria-label="태그">
          {tags.map((tag) => <li><a class="tag" href={tagUrl(tag)}>{tag}</a></li>)}
        </ul>
      )}
    </article>
    {toc.length > 1 && (
      <nav class="toc" aria-label="목차">
        <p>목차</p>
        <ol>
          {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}
  </div>
  {(newer || older) && (
    <nav class="pager" aria-label="다른 글">
      {older && <a href={postUrl(older)}><span>이전 글</span>{older.data.title}</a>}
      {newer && <a class="next" href={postUrl(newer)}><span>다음 글</span>{newer.data.title}</a>}
    </nav>
  )}
</Base>

<script>
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const box = document.createElement('div');
    box.className = 'code';
    pre.replaceWith(box);
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = '복사';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        button.textContent = '복사됨';
      } catch {
        button.textContent = '복사 실패';
      }
      setTimeout(() => (button.textContent = '복사'), 1500);
    });
    box.append(pre, button);
  }
</script>
